{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/Venus/schemas/backup-1.0.json",
  "title": "Venus Backup Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["backupFormatVersion", "appVersion", "createdAt", "backupType", "sections", "files", "source"],
  "properties": {
    "backupFormatVersion": {"const": "1.0"},
    "appVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "backupType": {"enum": ["full", "selective", "portable"]},
    "sections": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["settings", "profiles", "widgets", "notes", "folders", "tags", "tasks", "bookmarksLocal", "bookmarksBrowserSnapshot", "calendarEvents", "reminders", "notifications", "timers", "plugins", "pluginData", "assets"]}},
    "source": {"type": "object", "additionalProperties": false, "required": ["browser", "platform"], "properties": {"browser": {"enum": ["firefox", "chrome", "other"]}, "platform": {"type": "string", "maxLength": 64}}},
    "files": {"type": "array", "maxItems": 1000, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^(settings|profiles|widgets|notes|folders|tags|tasks|bookmarks-local|bookmarks-browser-snapshot|calendar-events|reminders|notifications|timers)\\.json$|^plugins/[a-z0-9_-]+\\.json$|^assets/[a-f0-9]{64}\\.(png|jpg|jpeg|webp)$"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 209715200}}}}
  }
}
